# What Vercel needs is package.json, package-lock.json and apps/web. Everything
# below is either local runtime state, a build artifact, or real client data.
#
# Vercel does NOT read .gitignore, so anything ignored there is uploaded unless
# it is named here. Without this file the upload is 3.6 GB.

# Local runtime state and caches
.wrangler
.sites-runtime
.pglite
.pglite-qa
node_modules
dist
# NOT excluded, though the header above says Vercel only needs apps/web:
#   .openai/hosting.json  and  build/sites-vite-plugin.ts
# Both are imported by vite.config.ts, so stripping them makes the PORTAL
# unbuildable from a Git checkout — `Could not resolve './.openai/hosting.json'`
# before the build has begun. They are two small tracked source files, not
# artifacts, and they cost nothing against the 3.6 GB this file exists to stop.
# The legacy portal's Build Output API staging root. Deployed from inside
# itself with `vercel deploy --prebuilt`, never as part of this project's
# upload — it is a second copy of dist/ plus a linked project of its own.
vercel/.deploy
.next
apps/web/.next
*.tsbuildinfo

# Real client data. db/backups is a database snapshot; .storage is the
# no-cloud-account file driver holding invoices, compliance certificates and
# photographs of the inside of client premises.
.storage
db/backups
db/monday-export
import-d1-report.txt
PHASE-2-AUDIT.md

# Secrets
.dev.vars
.env.monday
.env.supabase-parked
